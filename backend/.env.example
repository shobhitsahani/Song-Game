# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/song_game?schema=public&connection_limit=10"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX="songgame"

# Authentication
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Deezer OAuth
DEEZER_APP_ID=your-deezer-app-id
DEEZER_APP_SECRET=your-deezer-app-secret
DEEZER_REDIRECT_URI=http://localhost:4000/api/auth/deezer/callback

# YouTube
YOUTUBE_API_KEY=your-youtube-api-key

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Redis Room Cache
ROOM_CACHE_TTL=5000
